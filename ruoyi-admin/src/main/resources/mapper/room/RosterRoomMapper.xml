<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.room.mapper.RosterRoomMapper">
    
    <resultMap type="RosterRoom" id="RosterRoomResult">
        <result property="id"    column="id"    />
        <result property="roomNumber"    column="room_number"    />
        <result property="roomName"    column="room_name"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRosterRoomVo">
        select id, room_number, room_name, status, create_by, create_time, update_by, update_time from roster_room
    </sql>

    <!-- 查询总数据量（所有记录） -->
    <select id="selectRosterRoomTotalCount" resultType="java.lang.Integer">
        select count(*) from roster_room
    </select>

    <select id="selectRosterRoomList" parameterType="RosterRoom" resultMap="RosterRoomResult">
        <include refid="selectRosterRoomVo"/>
        <where>  
            <if test="roomNumber != null  and roomNumber != ''"> and room_number = #{roomNumber}</if>
            <if test="roomName != null  and roomName != ''"> and room_name like concat('%', #{roomName}, '%')</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
        </where>
    </select>
    
    <select id="selectRosterRoomById" parameterType="Long" resultMap="RosterRoomResult">
        <include refid="selectRosterRoomVo"/>
        where id = #{id}
    </select>

    <insert id="insertRosterRoom" parameterType="RosterRoom" useGeneratedKeys="true" keyProperty="id">
        insert into roster_room
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">room_number,</if>
            <if test="roomName != null">room_name,</if>
            <if test="status != null">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">#{roomNumber},</if>
            <if test="roomName != null">#{roomName},</if>
            <if test="status != null">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateRosterRoom" parameterType="RosterRoom">
        update roster_room
        <trim prefix="SET" suffixOverrides=",">
            <if test="roomNumber != null and roomNumber != ''">room_number = #{roomNumber},</if>
            <if test="roomName != null">room_name = #{roomName},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRosterRoomById" parameterType="Long">
        delete from roster_room where id = #{id}
    </delete>

    <delete id="deleteRosterRoomByIds" parameterType="String">
        delete from roster_room where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>