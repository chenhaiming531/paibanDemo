<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.relation.mapper.RosterStaffRelationMapper">

    <resultMap type="RosterStaffRelation" id="RosterStaffRelationResult">
        <result property="id"    column="id"    />
        <result property="scheduleDetailId"    column="schedule_detail_id"    />
        <result property="staffId"    column="staff_id"    /> <!-- 员工外键 -->
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <!-- 扩展ResultMap，包含员工信息（一对一）和手术台信息（一对多） -->
    <resultMap id="RosterStaffRelationWithStaffAndTablesResult" type="RosterStaffRelation" extends="RosterStaffRelationResult">
        <!-- 关联员工信息（一对一） -->
        <association property="rosterStaff" column="staff_id" javaType="com.ruoyi.staff.domain.RosterStaff" select="selectRosterStaffById"/>
        <!-- 关联手术台信息（一对多） -->
        <collection property="operatingTables" column="id" ofType="com.ruoyi.table.domain.OperatingTable" select="selectOperatingTablesByRelationId"/>
    </resultMap>

    <!-- 员工信息的基础映射 -->
    <resultMap type="RosterStaff" id="RosterStaffResult">
        <result property="id"    column="id"    />
        <result property="staffName"    column="staff_name"    />
        <result property="staffTypeId"    column="staff_type_id"    />
        <result property="staffGender"    column="staff_gender"    />
        <result property="department"    column="department"    />
        <result property="unit"    column="unit"    />
        <result property="jobTitle"    column="job_title"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectRosterStaffRelationVo">
        select id, schedule_detail_id, staff_id, create_by, create_time, update_by, update_time from roster_staff_relation
    </sql>

    <!-- 核心查询方法：使用关联员工和手术台的resultMap -->
    <select id="selectRosterStaffRelationList" parameterType="RosterStaffRelation" resultMap="RosterStaffRelationWithStaffAndTablesResult">
        <include refid="selectRosterStaffRelationVo"/>
        <where>
            <if test="scheduleDetailId != null "> and schedule_detail_id = #{scheduleDetailId}</if>
            <if test="staffId != null "> and staff_id = #{staffId}</if>
            <!-- 支持按员工类型筛选（通过关联的rosterStaff.staffTypeId） -->
            <if test="rosterStaff != null and rosterStaff.staffTypeId != null">
                and exists (
                select 1 from roster_staff s where s.id = staff_id and s.staff_type_id = #{rosterStaff.staffTypeId}
                )
            </if>
        </where>
    </select>

    <select id="selectRosterStaffRelationById" parameterType="Long" resultMap="RosterStaffRelationWithStaffAndTablesResult">
        <include refid="selectRosterStaffRelationVo"/>
        where id = #{id}
    </select>

    <!-- 查询单个员工信息（通过staff_id关联） -->
    <select id="selectRosterStaffById" parameterType="Long" resultMap="RosterStaffResult">
        select id, staff_name, staff_type_id, staff_gender, department, unit, job_title, status, create_by, create_time, update_by, update_time
        from roster_staff
        where id = #{staffId}
    </select>

    <!-- 查询多个手术台信息（通过relation_id关联） -->
    <select id="selectOperatingTablesByRelationId" parameterType="Long" resultMap="com.ruoyi.table.mapper.OperatingTableMapper.OperatingTableResult">
        select id, operation_name, relation_id, difficulty, create_by, create_time, update_by, update_time
        from operating_table
        where relation_id = #{id}
    </select>

    <!-- 其余insert/update/delete保持不变 -->
    <insert id="insertRosterStaffRelation" parameterType="RosterStaffRelation" useGeneratedKeys="true" keyProperty="id">
        insert into roster_staff_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="scheduleDetailId != null">schedule_detail_id,</if>
            <if test="staffId != null">staff_id,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="scheduleDetailId != null">#{scheduleDetailId},</if>
            <if test="staffId != null">#{staffId},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
        </trim>
    </insert>

    <update id="updateRosterStaffRelation" parameterType="RosterStaffRelation">
        update roster_staff_relation
        <trim prefix="SET" suffixOverrides=",">
            <if test="scheduleDetailId != null">schedule_detail_id = #{scheduleDetailId},</if>
            <if test="staffId != null">staff_id = #{staffId},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteRosterStaffRelationById" parameterType="Long">
        delete from roster_staff_relation where id = #{id}
    </delete>

    <delete id="deleteRosterStaffRelationByIds" parameterType="String">
        delete from roster_staff_relation where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteRosterStaffByIds" parameterType="String">
        delete from roster_staff where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteRosterStaffById" parameterType="Long">
        delete from roster_staff where id = #{id}
    </delete>

    <insert id="batchRosterStaff">
        insert into roster_staff( id, staff_name, staff_type_id, staff_gender, department, unit, job_title, status, create_by, create_time, update_by, update_time) values
        <foreach item="item" index="index" collection="list" separator=",">
            ( #{item.id}, #{item.staffName}, #{item.staffTypeId}, #{item.staffGender}, #{item.department}, #{item.unit}, #{item.jobTitle}, #{item.status}, #{item.createBy}, #{item.createTime}, #{item.updateBy}, #{item.updateTime})
        </foreach>
    </insert>
</mapper>